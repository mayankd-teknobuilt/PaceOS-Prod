{
  "name": "pace-qa-prod-modules",
  "version": "1.0.0",
  "description": "Production dashboard module navigation and Control Tower reports automation (Playwright POM)",
  "main": "index.js",
  "scripts": {
    "clean:reports": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$paths = 'allure-report','allure-results','playwright-report','test-results'; foreach ($path in $paths) { if (Test-Path $path) { Remove-Item -Recurse -Force $path } }\"",
    "test:prod-modules": "playwright test --project=prod-modules-email",
    "test:prod-modules:headed": "playwright test --project=prod-modules-email --headed",
    "test:prod-modules:each": "cross-env PACE_MODULE_EACH=true playwright test --project=prod-modules-email tests/prod-modules/All Modules",
    "test:prod-modules:each:headed": "cross-env PACE_MODULE_EACH=true playwright test --project=prod-modules-email tests/prod-modules/All Modules --headed",
    "test:fast": "playwright test --project=prod-modules-email --project=control-tower-reports-email --workers=4",
    "test:all": "playwright test --project=prod-modules-email --project=control-tower-reports-email --workers=4",
    "test:all:headed": "playwright test --project=prod-modules-email --project=control-tower-reports-email --headed",
    "test:headed": "playwright test --headed --workers=4",
    "test:prod-modules:badge": "cross-env INCLUDE_BADGE_AUTH=true playwright test --project=prod-modules-badge",
    "test:prod-modules:badge:headed": "cross-env INCLUDE_BADGE_AUTH=true playwright test --project=prod-modules-badge --headed",
    "test:prod-modules:report": "playwright test --project=prod-modules-email --reporter=html,list,allure-playwright",
    "test:control-tower-reports": "playwright test --project=control-tower-reports-email tests/Control-tower-reports --workers=4",
    "test:control-tower-reports:headed": "playwright test --project=control-tower-reports-email tests/Control-tower-reports --headed --workers=4",
    "test:control-tower-reports:badge": "cross-env INCLUDE_BADGE_AUTH=true playwright test --project=control-tower-reports-badge tests/Control-tower-reports",
    "test:control-tower-reports:badge:headed": "cross-env INCLUDE_BADGE_AUTH=true playwright test --project=control-tower-reports-badge tests/Control-tower-reports --headed --workers=4",
    "test:all:login-methods": "cross-env INCLUDE_BADGE_AUTH=true playwright test",
    "test:ci": "node scripts/validate-ci-env.js && cross-env CI=true playwright test --project=prod-modules-email --project=control-tower-reports-email --workers=4",
    "test:ci:prod-modules": "node scripts/validate-ci-env.js && cross-env CI=true playwright test --project=prod-modules-email",
    "test:ci:control-tower": "node scripts/validate-ci-env.js && cross-env CI=true playwright test --project=control-tower-reports-email --workers=4",
    "test:ci:fast": "node scripts/validate-ci-env.js && cross-env CI=true PACE_FAST=true playwright test --project=prod-modules-email --project=control-tower-reports-email --workers=4",
    "ci:install": "npm ci && npx playwright install --with-deps chromium",
    "test:ct:daily-progress": "playwright test --project=control-tower-reports-email tests/Control-tower-reports/daily-progress.spec.js",
    "test:ct:daily-progress:headed": "playwright test --project=control-tower-reports-email tests/Control-tower-reports/daily-progress.spec.js --headed",
    "test:ct:project-libraries": "playwright test --project=control-tower-reports-email tests/Control-tower-reports/project-libraries.spec.js",
    "test:ct:project-libraries:headed": "playwright test --project=control-tower-reports-email tests/Control-tower-reports/project-libraries.spec.js --headed",
    "test:ct:standard-libraries": "playwright test --project=control-tower-reports-email tests/Control-tower-reports/standard-libraries.spec.js",
    "test:ct:standard-libraries:headed": "playwright test --project=control-tower-reports-email tests/Control-tower-reports/standard-libraries.spec.js --headed",
    "test:ct:execution-overview": "playwright test --project=control-tower-reports-email tests/Control-tower-reports/execution-overview.spec.js",
    "test:ct:execution-overview:headed": "playwright test --project=control-tower-reports-email tests/Control-tower-reports/execution-overview.spec.js --headed",
    "test:ct:health-and-safety": "playwright test --project=control-tower-reports-email tests/Control-tower-reports/health-and-safety.spec.js",
    "test:ct:health-and-safety:headed": "playwright test --project=control-tower-reports-email tests/Control-tower-reports/health-and-safety.spec.js --headed",
    "generate:prod-modules": "node scripts/generate-stage-module-tests.js",
    "discover:prod-modules": "node scripts/discover-stage-modules.js",
    "discover:prod-project-context": "node scripts/discover-prod-project-context.js",
    "postinstall": "npx playwright install chromium",
    "generate:test-catalog": "node scripts/generate-test-catalog-excel.js",
    "report:open": "npx playwright show-report ./playwright-report",
    "allure:report": "allure serve allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.3.5",
    "allure-commandline": "^2.37.0",
    "allure-playwright": "^3.10.1",
    "dotenv": "^16.6.1",
    "cross-env": "^7.0.3",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "winston": "^3.19.0"
  }
}
