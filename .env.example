# Copy to .env.local for local runs, or set these as CI/CD secrets/variables.

# Target environment: set via npm scripts (PACE_ENV=prod | dev3), not in .env.local.
# Prod: npm run test:local:prod   Dev3: npm run test:local:dev3
# Optional override only when running node/playwright directly: PACE_ENV=prod

BASE_URL=https://goldenpasslng.pace-os.com/

# Email/password login (required for CI and local runs)
# GitHub Actions: set as repository Secrets OR Variables with these exact names.
TEST_EMAIL=your@email.com
TEST_PASSWORD=yourPassword

# Optional dev3-only credentials (CI dev3 jobs). If omitted, dev3 jobs use TEST_EMAIL / TEST_PASSWORD.
# DEV3_TEST_EMAIL=
# DEV3_TEST_PASSWORD=

# Badge login (set INCLUDE_BADGE_AUTH=true to run prod-modules-badge / control-tower-reports-badge)
# BADGE_PASSWORD falls back to TEST_PASSWORD when omitted.
BADGE_NUMBER=2116
# BADGE_PASSWORD=

# Project context (defaults shown; override if needed)
PROD_USE_FIRST_PROJECT=true
# PROD_PROJECT_NAME=
PROD_PHASE=Process Train - 2
PROD_SECTION=2200 - Main Piperack
PROD_BLOCK=2210-Main Piperack (Level - 5)

# Control Tower
CONTROL_TOWER_PORTFOLIO_URL=https://us-controltower.pace-os.com/#/portfolio?page=1
# PROD_CONTROL_TOWER_TAB=Digital Control Tower
# PROD_CONTROL_TOWER_MODULE=Digital Control Tower

# Runtime tuning
# CASE_TIMEOUT_MS=90000
# CASE_ATTEMPT_MS=45000
# DOWNLOAD_TIMEOUT_MS=15000
# CT_VIEW_LOAD_MS=25000
# PLAYWRIGHT_WORKERS=4
# PACE_FAST=true
# INCLUDE_BADGE_AUTH=false
# PW_HEADED=false
# PROD_STEP_PAUSE_MS=0

# Email report (required for daily status emails in CI)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=mayankd@teknobuilt.com
# Set SMTP_PASSWORD in .env.local locally and as a GitHub Actions secret in CI.
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=mayankd@teknobuilt.com
EMAIL_TO=mayankd@teknobuilt.com
EMAIL_SUBJECT_PREFIX=[Prod Sanity PACE QA Daily Report]
