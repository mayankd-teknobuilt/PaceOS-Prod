# =============================================================================
# TEMPLATE — commit this file. Copy to .env.local (gitignored) for local prod runs.
# Do not put real passwords in .env.example.
# =============================================================================

# Target environment: prefer npm scripts (PACE_ENV=prod | dev3), not .env.local.
# Prod:  npm run test:local:prod
# Dev3:  npm run test:local:dev3  (uses .env.dev3.local — see .env.dev3.example)

BASE_URL=https://goldenpasslng.pace-os.com/

# Required for local runs and CI (GitHub Actions secrets: TEST_EMAIL, TEST_PASSWORD)
TEST_EMAIL=your@email.com
TEST_PASSWORD=yourPassword

# Optional: separate dev3 login for CI only (mapped in playwright-ci.yml dev3 jobs)
# DEV3_TEST_EMAIL=
# DEV3_TEST_PASSWORD=

# Badge projects (prod-modules-badge / control-tower-reports-badge)
# INCLUDE_BADGE_AUTH=true
BADGE_NUMBER=
# BADGE_PASSWORD=   # falls back to TEST_PASSWORD

# Project context (defaults match config/environments.js prod profile)
PROD_USE_FIRST_PROJECT=true
# PROD_PROJECT_NAME=
PROD_PHASE=Process Train - 2
PROD_SECTION=2200 - Main Piperack
PROD_BLOCK=2210-Main Piperack (Level - 5)

# Control Tower (prod profile overrides dev URLs if PACE_ENV=prod)
CONTROL_TOWER_PORTFOLIO_URL=https://us-controltower.pace-os.com/#/portfolio?page=1
# CONTROL_TOWER_URL_PATTERN=controltower\.pace-os\.com
# PROD_CONTROL_TOWER_TAB=Digital Control Tower
# PROD_CONTROL_TOWER_MODULE=Digital Control Tower

# Timeouts (CI sets CASE_* via workflow; local prod defaults are lower unless set)
# CASE_TIMEOUT_MS=90000
# CASE_ATTEMPT_MS=45000
# SLOW_CASE_TIMEOUT_MS=180000
# SLOW_CASE_ATTEMPT_MS=90000
# DOWNLOAD_TIMEOUT_MS=90000
# CT_VIEW_LOAD_MS=25000
# PLAYWRIGHT_WORKERS=4

# PACE_FAST=true
# PW_HEADED=true
# PROD_STEP_PAUSE_MS=0

# QA report delivery via Microsoft Power Automate (HTTP trigger → Outlook Send an email V2)
# Store the full HTTPS trigger URL in GitHub Actions secret POWER_AUTOMATE_WEBHOOK_URL (never commit it).
# POWER_AUTOMATE_WEBHOOK_URL=
EMAIL_TO=report-recipient@example.com
EMAIL_SUBJECT_PREFIX=[PACE QA Daily Report]
