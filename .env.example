# Copy to .env.local for local runs, or set these as CI/CD secrets/variables.

BASE_URL=https://goldenpasslng.pace-os.com/

# Email/password login (required)
TEST_EMAIL=your@email.com
TEST_PASSWORD=yourPassword

# Badge login (optional — only when INCLUDE_BADGE_AUTH=true)
# BADGE_NUMBER=
# BADGE_PASSWORD=

# Project context (defaults shown; override if needed)
PROD_USE_FIRST_PROJECT=true
# PROD_PROJECT_NAME=
PROD_PHASE=Process Train - 2
PROD_SECTION=2200 - Main Piperack
PROD_BLOCK=2210-Main Piperack (Level - 5)

# Control Tower
CONTROL_TOWER_PORTFOLIO_URL=https://us-controltower.pace-os.com/#/portfolio?page=1
# PROD_CONTROL_TOWER_TAB=Digital Control Tower
# PROD_CONTROL_TOWER_MODULE=Digital Control Tower

# Runtime tuning
# PLAYWRIGHT_WORKERS=4
# CT_WORKERS=4
# PACE_FAST=true
# PACE_MODULE_EACH=false
# INCLUDE_BADGE_AUTH=false
# PW_HEADED=false
# PROD_STEP_PAUSE_MS=0
