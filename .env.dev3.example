# Copy to .env.dev3.local (gitignored). Run with: npm run test:dev3:prod-modules
# Or set PACE_ENV=dev3 in .env.local together with credentials below.

PACE_ENV=dev3

TEST_EMAIL=admin@teknobuilt.com
# No quotes. Characters like $ [ ] = are safe in .env.dev3.local (loaded with dotenv.parse).
TEST_PASSWORD=your-dev3-password

# Optional overrides (defaults come from config/environments.js dev3 profile)
